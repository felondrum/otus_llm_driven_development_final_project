# ===========================================
# Module 1 - Core Engine Environment
# ===========================================
# Пример переменных окружения для запуска модуля

# Redis
REDIS_PASSWORD=redis123

# PostgreSQL (Langfuse v3)
POSTGRES_USER=langfuse
POSTGRES_PASSWORD=langfuse
POSTGRES_DB=langfuse

# ClickHouse
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=clickhouse123

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# Langfuse
SALT=strong-salt-value-for-api-key-encryption-12345
ENCRYPTION_KEY=test1234567890
NEXTAUTH_SECRET=change-me

# Yandex LLM (обновите реальными ключами)
YA_LLM_KEY=your-yandex-llm-key-here
YA_HOST_KEY=your-yandex-folder-id-here

# Langfuse credentials (получите на http://localhost:3000 после первого запуска)
LANGFUSE_PUBLIC_KEY=your-public-key-here
LANGFUSE_SECRET_KEY=your-secret-key-here

# Хосты сервисов
OLLAMA_URL=http://ollama:11434
LANGFUSE_HOST=http://langfuse-web:3000
